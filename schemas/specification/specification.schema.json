{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productprotocol.org/schemas/specification/specification.schema.json",
  "title": "Specification",
  "description": "Structured, versioned statement of what to build for a scope of Capabilities and Features. Normative per PP-0004 §2.",
  "$ref": "../common/envelope.schema.json",
  "properties": {
    "kind": {
      "const": "Specification"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "lifecycle": {
          "$ref": "../common/common.schema.json#/$defs/governedLifecycle"
        }
      },
      "required": [
        "lifecycle"
      ]
    },
    "spec": {
      "$ref": "../common/common.schema.json#/$defs/extensibleObject",
      "properties": {
        "scope": {
          "$ref": "../common/common.schema.json#/$defs/refList",
          "minItems": 1
        },
        "summary": {
          "$ref": "../common/common.schema.json#/$defs/prose"
        },
        "businessGoals": {
          "$ref": "../common/common.schema.json#/$defs/refList"
        },
        "personas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "$ref": "../common/common.schema.json#/$defs/prose"
              },
              "needs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "name",
              "description"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x-": {}
            }
          }
        },
        "functionalRequirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "$ref": "../common/common.schema.json#/$defs/prose"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ],
                "default": "medium"
              },
              "rationale": {
                "$ref": "../common/common.schema.json#/$defs/prose"
              }
            },
            "required": [
              "id",
              "statement"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x-": {}
            }
          }
        },
        "nonFunctionalRequirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "enum": [
                  "performance",
                  "security",
                  "accessibility",
                  "reliability",
                  "usability",
                  "compliance",
                  "scalability",
                  "maintainability",
                  "other"
                ]
              },
              "statement": {
                "$ref": "../common/common.schema.json#/$defs/prose"
              },
              "budget": {
                "type": "object",
                "properties": {
                  "metric": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "unit": {
                    "type": "string"
                  }
                },
                "required": [
                  "metric",
                  "value"
                ],
                "additionalProperties": false,
                "patternProperties": {
                  "^x-": {}
                }
              }
            },
            "required": [
              "id",
              "category",
              "statement"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x-": {}
            }
          }
        },
        "ux": {
          "type": "object",
          "properties": {
            "principles": {
              "type": "array",
              "items": {
                "$ref": "../common/common.schema.json#/$defs/prose"
              }
            },
            "prototypes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "artifact": {
                    "$ref": "../common/common.schema.json#/$defs/ref"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "html",
                      "markdown",
                      "image",
                      "other"
                    ]
                  }
                },
                "required": [
                  "name",
                  "format"
                ],
                "additionalProperties": false,
                "patternProperties": {
                  "^x-": {}
                }
              }
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^x-": {}
          }
        },
        "businessRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "$ref": "../common/common.schema.json#/$defs/prose"
              },
              "appliesTo": {
                "$ref": "../common/common.schema.json#/$defs/refList"
              }
            },
            "required": [
              "id",
              "statement"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x-": {}
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "../common/common.schema.json#/$defs/prose"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "ref": {
                "$ref": "../common/common.schema.json#/$defs/ref"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x-": {}
            }
          }
        },
        "acceptance": {
          "$ref": "../common/common.schema.json#/$defs/refList"
        }
      },
      "required": [
        "scope",
        "summary"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    }
  }
}
