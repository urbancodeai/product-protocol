{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productprotocol.org/schemas/evaluation/golden-test.schema.json",
  "title": "GoldenTest",
  "description": "A canonical, versioned scenario the Product must always satisfy. Governed object. Normative per PP-0008 §6.",
  "$ref": "../common/envelope.schema.json",
  "properties": {
    "kind": {
      "const": "GoldenTest"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "lifecycle": {
          "$ref": "../common/common.schema.json#/$defs/governedLifecycle"
        }
      },
      "required": [
        "lifecycle"
      ]
    },
    "spec": {
      "$ref": "../common/common.schema.json#/$defs/extensibleObject",
      "properties": {
        "scenario": {
          "$ref": "../common/common.schema.json#/$defs/prose"
        },
        "inputs": {
          "type": "object",
          "description": "Fixed inputs for the scenario. Free-form object."
        },
        "expected": {
          "$ref": "../common/common.schema.json#/$defs/prose"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "$ref": "../common/common.schema.json#/$defs/prose"
              }
            },
            "required": [
              "step"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x-": {}
            }
          }
        },
        "method": {
          "type": "string",
          "enum": [
            "automated",
            "agentic",
            "manual"
          ]
        },
        "appliesTo": {
          "$ref": "../common/common.schema.json#/$defs/refList"
        },
        "tolerance": {
          "$ref": "../common/common.schema.json#/$defs/prose"
        }
      },
      "required": [
        "scenario",
        "expected",
        "method"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    }
  }
}
