{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productprotocol.org/schemas/evaluation/quality-gate.schema.json",
  "title": "QualityGate",
  "description": "A named predicate over Evaluations that gates a transition. Normative per PP-0008 §9.",
  "$ref": "../common/envelope.schema.json",
  "properties": {
    "kind": {
      "const": "QualityGate"
    },
    "spec": {
      "$ref": "../common/common.schema.json#/$defs/extensibleObject",
      "properties": {
        "description": {
          "$ref": "../common/common.schema.json#/$defs/prose"
        },
        "trigger": {
          "type": "string",
          "enum": [
            "task_acceptance",
            "deployment_promotion",
            "constitution_audit",
            "scheduled"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "blocking",
            "advisory"
          ]
        },
        "requires": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "$ref": "../common/common.schema.json#/$defs/prose"
              },
              "evaluations": {
                "$ref": "../common/common.schema.json#/$defs/refList"
              },
              "selector": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string",
                    "enum": [
                      "regression",
                      "visual",
                      "business_validation",
                      "agent_evaluation",
                      "performance",
                      "security",
                      "accessibility",
                      "constitution_audit",
                      "acceptance"
                    ]
                  },
                  "labels": {
                    "$ref": "../common/common.schema.json#/$defs/stringMap"
                  }
                },
                "additionalProperties": false,
                "patternProperties": {
                  "^x-": {}
                }
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "pass"
                ],
                "default": "pass"
              },
              "minScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "description"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x-": {}
            }
          }
        }
      },
      "required": [
        "description",
        "trigger",
        "mode",
        "requires"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    }
  }
}
