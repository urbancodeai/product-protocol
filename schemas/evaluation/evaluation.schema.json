{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productprotocol.org/schemas/evaluation/evaluation.schema.json",
  "title": "Evaluation",
  "description": "The append-only record of judging a subject against criteria, with Evidence. Normative per PP-0008 §4 and §8.",
  "$ref": "../common/envelope.schema.json",
  "properties": {
    "kind": { "const": "Evaluation" },
    "spec": {
      "$ref": "../common/common.schema.json#/$defs/extensibleObject",
      "properties": {
        "subject": { "$ref": "../common/common.schema.json#/$defs/ref" },
        "category": {
          "type": "string",
          "enum": [
            "regression",
            "visual",
            "business_validation",
            "agent_evaluation",
            "performance",
            "security",
            "accessibility",
            "constitution_audit",
            "acceptance"
          ]
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "source": { "$ref": "../common/common.schema.json#/$defs/ref" },
              "description": { "$ref": "../common/common.schema.json#/$defs/prose" }
            },
            "required": ["description"],
            "additionalProperties": false
          }
        },
        "verdict": {
          "type": "string",
          "enum": ["pass", "fail", "error", "inconclusive"]
        },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "score": { "type": "number", "minimum": 0, "maximum": 1 },
              "weight": { "type": "number", "minimum": 0 }
            },
            "required": ["name", "score"],
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceItem" }
        },
        "evaluator": { "$ref": "../common/common.schema.json#/$defs/ref" },
        "evaluatedAt": { "$ref": "../common/common.schema.json#/$defs/timestamp" },
        "notes": { "$ref": "../common/common.schema.json#/$defs/prose" }
      },
      "required": [
        "subject",
        "category",
        "criteria",
        "verdict",
        "evidence",
        "evaluator",
        "evaluatedAt"
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "description": "A single item of Evidence. PP-0008 §8. At least one of uri, path, digest, or artifact is required.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "log",
            "screenshot",
            "test_report",
            "trace",
            "measurement",
            "diff",
            "transcript",
            "other"
          ]
        },
        "description": { "$ref": "../common/common.schema.json#/$defs/prose" },
        "uri": { "type": "string", "format": "uri" },
        "path": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "../common/common.schema.json#/$defs/digest" },
        "artifact": { "$ref": "../common/common.schema.json#/$defs/ref" }
      },
      "required": ["type"],
      "anyOf": [
        { "required": ["uri"] },
        { "required": ["path"] },
        { "required": ["digest"] },
        { "required": ["artifact"] }
      ],
      "additionalProperties": false
    }
  }
}
