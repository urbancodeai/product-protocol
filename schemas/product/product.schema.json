{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productprotocol.org/schemas/product/product.schema.json",
  "title": "Product",
  "description": "The root object of a Product Protocol tree. Normative per PP-0002 §9.",
  "$ref": "../common/envelope.schema.json",
  "properties": {
    "kind": { "const": "Product" },
    "spec": {
      "$ref": "../common/common.schema.json#/$defs/extensibleObject",
      "properties": {
        "summary": { "$ref": "../common/common.schema.json#/$defs/prose" },
        "brain": { "$ref": "../common/common.schema.json#/$defs/ref" },
        "constitutions": {
          "$ref": "../common/common.schema.json#/$defs/refList",
          "minItems": 1
        },
        "goals": { "$ref": "../common/common.schema.json#/$defs/refList" },
        "environments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "$ref": "../common/common.schema.json#/$defs/id" },
              "classification": {
                "type": "string",
                "enum": ["development", "test", "pre_production", "production"]
              },
              "description": { "type": "string" }
            },
            "required": ["name", "classification"],
            "additionalProperties": false
          }
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "uri": { "type": "string", "format": "uri" },
              "role": { "type": "string", "enum": ["source", "artifact", "knowledge", "other"] }
            },
            "required": ["name", "uri", "role"],
            "additionalProperties": false
          }
        }
      },
      "required": ["summary", "brain", "constitutions"],
      "additionalProperties": false
    }
  }
}
