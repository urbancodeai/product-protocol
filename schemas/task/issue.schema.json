{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productprotocol.org/schemas/task/issue.schema.json",
  "title": "Issue",
  "description": "A tracked defect, risk, or anomaly requiring resolution. Planning role per PP-0006 §2.3; triage lifecycle per PP-0010 §6.4.",
  "$ref": "../common/envelope.schema.json",
  "properties": {
    "kind": {
      "const": "Issue"
    },
    "spec": {
      "$ref": "../common/common.schema.json#/$defs/extensibleObject",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "$ref": "../common/common.schema.json#/$defs/prose"
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "observation",
                "evaluation",
                "human",
                "constitution_violation"
              ]
            },
            "ref": {
              "$ref": "../common/common.schema.json#/$defs/ref"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "patternProperties": {
            "^x-": {}
          }
        },
        "affects": {
          "$ref": "../common/common.schema.json#/$defs/refList"
        },
        "resolution": {
          "$ref": "../common/common.schema.json#/$defs/prose"
        }
      },
      "required": [
        "title",
        "description",
        "severity"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "status": {
      "$ref": "../common/common.schema.json#/$defs/extensibleObject",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "open",
            "triaged",
            "planned",
            "resolved",
            "closed"
          ]
        },
        "tasks": {
          "$ref": "../common/common.schema.json#/$defs/refList"
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    }
  }
}
