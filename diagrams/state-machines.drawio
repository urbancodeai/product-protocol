        </mxCell>
        <mxCell id="te2" value="worker claims" style="html=1;" edge="1" parent="1" source="ready" target="claimed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te3" value="worker starts" style="html=1;" edge="1" parent="1" source="claimed" target="inprogress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te4" value="dependency / question" style="html=1;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="inprogress" target="blocked">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te5" value="unblocked" style="html=1;exitX=0.75;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="blocked" target="inprogress">
          <mxGeometry relative="1" as="geometry" />
