      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tstart" value="" style="ellipse;fillColor=#000000;html=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="pending" value="pending" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="60" width="110" height="40" as="geometry" />
