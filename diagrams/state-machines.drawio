        <mxCell id="te9" value="rejected" style="html=1;" edge="1" parent="1" source="evaluating" target="rejected">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te10" value="replan / retry" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="rejected" target="ready">
          <mxGeometry relative="1" as="geometry" />
