        <mxCell id="te11" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="pending" target="cancelled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te12" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="ready" target="cancelled">
