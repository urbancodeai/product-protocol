        <mxCell id="approved" value="approved" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="85" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="deprecated" value="deprecated" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="85" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="archived" value="archived" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="85" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ge0" style="html=1;" edge="1" parent="1" source="start" target="draft">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge1" value="submit" style="html=1;" edge="1" parent="1" source="draft" target="proposed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge2" value="revise" style="html=1;curved=1;exitX=0.25;exitY=0;entryX=0.75;entryY=0;" edge="1" parent="1" source="proposed" target="draft">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge3" value="human approval (Decision)" style="html=1;" edge="1" parent="1" source="proposed" target="approved">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge4" value="supersede / retire" style="html=1;" edge="1" parent="1" source="approved" target="deprecated">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge5" style="html=1;" edge="1" parent="1" source="deprecated" target="archived">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pp-task-lifecycle" name="Task">
