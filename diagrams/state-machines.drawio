        <mxCell id="cancelled" value="cancelled" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="180" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="te0" style="html=1;" edge="1" parent="1" source="tstart" target="pending">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te1" value="dependencies satisfied" style="html=1;" edge="1" parent="1" source="pending" target="ready">
